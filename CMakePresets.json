{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (VS 2022)",
      "description": "Visual Studio 2022 multi-config generator",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release (Ninja)",
      "description": "Single-config Release with Ninja (faster CI/local)",
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/build/ninja-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Build Debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "displayName": "Build Release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "relwithdebinfo",
      "displayName": "Build RelWithDebInfo",
      "configurePreset": "windows-x64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "ninja-release",
      "displayName": "Build Ninja Release",
      "configurePreset": "windows-x64-release"
    }
  ],
  "workflowPresets": [
    {
      "name": "release",
      "displayName": "Configure + Build Release",
      "steps": [
        {
          "type": "configure",
          "name": "windows-x64"
        },
        {
          "type": "build",
          "name": "release"
        }
      ]
    },
    {
      "name": "debug",
      "displayName": "Configure + Build Debug",
      "steps": [
        {
          "type": "configure",
          "name": "windows-x64"
        },
        {
          "type": "build",
          "name": "debug"
        }
      ]
    }
  ]
}
